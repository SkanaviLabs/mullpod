# Copy to .env. Secrets only: everything else is in config.yaml.
# From https://mullvad.net/en/account/wireguard-config (generate a key for a new
# device, pick any server, download the .conf):
#   [Interface] PrivateKey = ...                  -> WIREGUARD_PRIVATE_KEY
#   [Interface] Address    = 10.x.x.x/32,fc00:... -> WIREGUARD_ADDRESSES (IPv4 part only)
WIREGUARD_PRIVATE_KEY=
# Replace with the IPv4 Address from your .conf (e.g. 10.66.12.34/32). This is a
# placeholder; the address must belong to the same device as the key above.
WIREGUARD_ADDRESSES=10.0.0.2/32

# Optional: every client must send this as the proxy password.
PROXY_PASSWORD=
